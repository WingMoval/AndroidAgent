<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The host performs real model requests. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      AG.V2-2: ADB runtime / mDNS discovery permissions (minimal set
      needed by V3 AdbRuntime's readiness + NSD discovery). These mirror
      what V3 :adb-engine declares.

      WRITE_SECURE_SETTINGS is a product capability declaration
      (signature|privileged). It lets the app control Settings.Global
      adb_wifi_enabled for post-bootstrap Auto-WD. It is NOT granted on a
      fresh install (FIRST_USE_MANUAL_BOOTSTRAP = REQUIRED): the user
      manually enables WD once, pairs/trusts, and the app then self-grants
      via `pm grant` over its own verified ADB shell.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="35" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="35" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidAgent">

        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AG.ADB-CONNECTION-PAGE-0: Dedicated ADB Connection / Pairing page. -->
        <activity
            android:name=".AdbConnectionActivity"
            android:exported="false"
            android:parentActivityName=".ChatActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- AG.SESSION-MANAGEMENT-UX-0: central Session Management surface. -->
        <activity
            android:name=".SessionManagementActivity"
            android:exported="false"
            android:parentActivityName=".ChatActivity"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
