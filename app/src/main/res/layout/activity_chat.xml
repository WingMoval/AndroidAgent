<?xml version="1.0" encoding="utf-8"?>
<!--
  AG.UI-SHELL-1 — VNext fixed Agent Workspace shell.
  Product Controls Alignment: Composer LLM selector, Provider Settings entry,
  Sidebar reorder (ADB → Provider → Session), compact header.

  Structure:
    FrameLayout (root, workspace bg)
      ├── LinearLayout (vertical, main 3-zone frame)
      │     ├── Header        (fixed, 44dp)  : ☰ + AndroidAgent + ADB ●
      │     ├── Viewport      (fills, 0dp)   : ScrollView → transcript TextView
      │     ├── Compact status (fixed, wrap) : secondary caption
      │     └── Composer      (fixed, wrap)  : ＋ + input + LLM ▼ + Send/Stop
      ├── Scrim       (fills, hidden)
      └── Sidebar     (left, 304dp, hidden)  : ADB / Provider / Session
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workspace_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ws_workspace_bg">

    <!-- ============================ Main 3-zone frame ============================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ============================ Header (fixed, lightweight) ============================ -->
        <LinearLayout
            android:id="@+id/workspace_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ws_header_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/ws_header_bg"
            android:paddingStart="@dimen/ws_spacing_sm"
            android:paddingEnd="@dimen/ws_spacing_md">

            <ImageButton
                android:id="@+id/btn_open_sidebar"
                android:layout_width="@dimen/ws_touch"
                android:layout_height="@dimen/ws_touch"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ws_open_sidebar"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_sort_by_size" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/ws_spacing_xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/ws_text_primary"
                android:textSize="@dimen/ws_text_title"
                android:textStyle="normal" />

            <!-- ADB compact indicator: "ADB ●" only (no duplicate text) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ws_adb_short"
                    android:textColor="@color/ws_text_secondary"
                    android:textSize="@dimen/ws_text_label" />

                <View
                    android:id="@+id/adb_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="@dimen/ws_spacing_xs"
                    android:background="@color/ws_adb_disconnected"
                    android:contentDescription="@string/ws_adb_disconnected" />
            </LinearLayout>
        </LinearLayout>

        <!-- hairline under header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ws_divider" />

        <!-- ============================ Conversation Viewport (fills) ============================ -->
        <!-- AG.UI-TRANSCRIPT-CARDS-1: RecyclerView replaces single TextView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/transcript_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <!-- ============================ Compact status (fixed) ============================ -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ws_status"
            android:paddingStart="@dimen/ws_spacing_lg"
            android:paddingEnd="@dimen/ws_spacing_lg"
            android:paddingTop="@dimen/ws_spacing_xs"
            android:paddingBottom="@dimen/ws_spacing_xs"
            android:textColor="@color/ws_text_hint"
            android:textSize="@dimen/ws_text_caption" />

        <!-- ============================ Composer (unified surface) ============================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ws_spacing_sm"
            android:paddingEnd="@dimen/ws_spacing_sm"
            android:paddingTop="@dimen/ws_spacing_xs"
            android:paddingBottom="@dimen/ws_spacing_sm">

            <LinearLayout
                android:id="@+id/composer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/ws_composer_surface"
                android:paddingStart="@dimen/ws_composer_padding"
                android:paddingEnd="@dimen/ws_composer_padding"
                android:paddingTop="@dimen/ws_spacing_sm"
                android:paddingBottom="@dimen/ws_spacing_sm">

                <!-- + Context slot: VISIBLE, opens attachment menu (honest: disabled items) -->
                <ImageButton
                    android:id="@+id/composer_add"
                    android:layout_width="@dimen/ws_touch"
                    android:layout_height="@dimen/ws_touch"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ws_add_context"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_input_add" />

                <EditText
                    android:id="@+id/composer_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/ws_input_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textMultiLine"
                    android:maxLines="5"
                    android:minHeight="@dimen/ws_touch"
                    android:paddingStart="@dimen/ws_spacing_xs"
                    android:paddingEnd="@dimen/ws_spacing_sm"
                    android:textColor="@color/ws_text_primary"
                    android:textColorHint="@color/ws_text_hint"
                    android:textSize="@dimen/ws_text_body" />

                <!-- LLM Selector: shows current model + dropdown arrow -->
                <LinearLayout
                    android:id="@+id/composer_model_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ws_spacing_xs"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ws_spacing_xs"
                    android:paddingEnd="@dimen/ws_spacing_xs"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/composer_model_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="start"
                        android:maxLines="1"
                        android:maxWidth="120dp"
                        android:text="@string/ws_model_placeholder"
                        android:textColor="@color/ws_text_secondary"
                        android:textSize="@dimen/ws_text_label" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@android:drawable/arrow_down_float"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <!-- Send / Stop compact action slot -->
                <FrameLayout
                    android:layout_width="@dimen/ws_touch"
                    android:layout_height="@dimen/ws_touch"
                    android:layout_marginStart="@dimen/ws_spacing_xs">

                    <ImageButton
                        android:id="@+id/composer_send"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/ws_send_btn"
                        android:contentDescription="@string/ws_send"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_send" />

                    <ImageButton
                        android:id="@+id/composer_stop"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/ws_stop_btn"
                        android:contentDescription="@string/ws_stop"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============================ Sidebar scrim ============================ -->
    <View
        android:id="@+id/sidebar_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ws_scrim"
        android:visibility="invisible" />

    <!-- ============================ Sidebar (transitional) ============================ -->
    <!-- Order: ADB → Provider/Models → Session -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="@dimen/ws_sidebar_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/ws_surface"
        android:orientation="vertical"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/ws_header_height"
            android:paddingStart="@dimen/ws_spacing_md"
            android:paddingEnd="@dimen/ws_spacing_sm">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/ws_text_primary"
                android:textSize="@dimen/ws_text_title"
                android:textStyle="normal" />

            <ImageButton
                android:id="@+id/btn_close_sidebar"
                android:layout_width="@dimen/ws_touch"
                android:layout_height="@dimen/ws_touch"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ws_close_sidebar"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ws_divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ws_spacing_lg">

                <!-- ===== ADB section (AG.ADB-CONNECTION-UX-1R: single row) ===== -->
                <LinearLayout
                    android:id="@+id/sidebar_adb_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ws_spacing_sm">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ws_adb_short"
                        android:textColor="@color/ws_text_primary"
                        android:textSize="@dimen/ws_text_caption" />

                    <View
                        android:id="@+id/sidebar_adb_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@color/ws_adb_disconnected"
                        android:contentDescription="@string/ws_adb_disconnected" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/ws_spacing_md"
                    android:layout_marginBottom="@dimen/ws_spacing_md"
                    android:background="@color/ws_divider" />

                <!-- ===== Provider / Models section (second) ===== -->
                <TextView
                    android:id="@+id/sidebar_provider_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/ws_spacing_sm"
                    android:text="@string/ws_section_models_provider"
                    android:textColor="@color/ws_text_primary"
                    android:textSize="@dimen/ws_text_caption" />

                <TextView
                    android:id="@+id/sidebar_provider_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ws_spacing_sm"
                    android:layout_marginBottom="@dimen/ws_spacing_sm"
                    android:textColor="@color/ws_text_secondary"
                    android:textSize="@dimen/ws_text_label" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/ws_spacing_md"
                    android:layout_marginBottom="@dimen/ws_spacing_md"
                    android:background="@color/ws_divider" />

                <!-- ===== Session section (third, moved down) ===== -->
                <TextView
                    android:id="@+id/sidebar_session_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ws_section_session"
                    android:textColor="@color/ws_text_secondary"
                    android:textSize="@dimen/ws_text_label"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sidebar_current_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ws_spacing_xs"
                    android:text="@string/ws_current_session"
                    android:textColor="@color/ws_text_primary"
                    android:textSize="@dimen/ws_text_caption" />

                <Button
                    android:id="@+id/sidebar_new_session"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ws_spacing_xs"
                    android:minHeight="@dimen/ws_touch"
                    android:text="@string/ws_new_session_compact"
                    android:textColor="@color/ws_text_secondary" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
