<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.androidterminal</groupId>
  <artifactId>at-core</artifactId>
  <version>0.1.0</version>
  <packaging>aar</packaging>
  <description>AT Engine Core — frozen implementation + JNI + arm64-v8a native libs. Byte-identical copy from third_party/at-engine-handoff-v0/artifacts/at-core.aar. Local metadata only; AAR bytes never repackaged.</description>
  <dependencies>
    <dependency>
      <groupId>androidx.core</groupId>
      <artifactId>core-ktx</artifactId>
      <version>1.13.1</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>